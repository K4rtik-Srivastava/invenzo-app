# Copy this file to .env and fill in the values.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Neon database connection strings (Neon dashboard → Connect).
# DATABASE_URL: "Pooled connection" switched ON  (host contains "-pooler")
# DIRECT_URL:   "Pooled connection" switched OFF (used for migrations)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Separate database used ONLY by automated tests (npm test). It is wiped on
# every test run, so never point it at your real data. Use a Neon branch
# called "test" (pooling OFF).
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-yyyy.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Long random string. Generate one with:  openssl rand -hex 32
BETTER_AUTH_SECRET=""
# Full address of the app. On your computer: http://localhost:3000.
# On Vercel you can leave it out: the project's main address is used automatically.
BETTER_AUTH_URL="http://localhost:3000"

# First Admin account, created by the seed script (npm run db:seed).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_NAME="Admin"

# Timezone used for "today" on the dashboard.
APP_TIMEZONE="Asia/Kolkata"

# Optional: forgot-password emails via https://resend.com. Leave blank to disable;
# admins can still reset passwords from the Users page.
RESEND_API_KEY=""
EMAIL_FROM="INVENZO <no-reply@yourshop.in>"
